QMainWindow { background: #f3f5f8; color: #25364b; }
QWidget { font-family: "Segoe UI", "Helvetica Neue", sans-serif; font-size: 12px; color: #25364b; }
QFrame#appHeader { background: #182c43; border: 0; }
QLabel#brand { color: #f4f8fd; font-size: 18px; letter-spacing: 1px; }
QLabel#architectureBadge { color: #b8cce2; font-size: 10px; }
QLineEdit#projectName { background: #253d56; color: #f4f8fd; border: 1px solid #39526b; padding: 8px 12px; border-radius: 4px; }
QFrame#workflowBar { background: #f9fafc; border-bottom: 1px solid #d5dce5; }
QTabBar#workflowTabs::tab { background: transparent; border: 0; border-bottom: 3px solid transparent; padding: 16px 24px 13px; color: #60738a; font-size: 13px; font-weight: 500; }
QTabBar#workflowTabs::tab:selected { color: #176bb8; border-bottom-color: #2285d4; background: #eef5fc; }
QTabBar#workflowTabs::tab:hover { background: #edf2f8; }
QStackedWidget#ribbon { background: #eef1f5; border-bottom: 1px solid #d2dce7; }
QStackedWidget#propertyPages { background: #ffffff; border-left: 1px solid #d5dce7; }
QFrame#navigator { background: #fafbfd; border-right: 1px solid #d5dce7; }
QLabel#eyebrow { color: #8090a2; font-size: 10px; letter-spacing: 1.1px; }
QLabel#sectionTitle { color: #23384d; font-size: 18px; font-weight: 600; }
QFrame#viewBar { background: #f9fbfd; border-bottom: 1px solid #d4dee9; }
QLabel#sourceLabel { color: #52708d; background: #f1f6fb; padding: 11px; border: 1px solid #dce6f0; border-radius: 5px; }
QLabel#hint { color: #74859a; font-size: 11px; line-height: 1.5; }
QLabel#selectionLabel { color: #52708d; padding: 7px 0; }
QLabel#qualitySummary { background: #edf6f0; color: #346f51; padding: 13px; border: 1px solid #d1e8da; border-radius: 5px; }
QLabel#exportNotes { background: #f0f5fc; color: #4c6a8b; padding: 13px; border: 1px solid #d8e3f0; border-radius: 5px; }
QPushButton { background: #ffffff; border: 1px solid #ccd6e1; border-radius: 4px; padding: 8px 13px; color: #38526d; }
QPushButton:hover { background: #f0f6fd; border-color: #8bb4d9; }
QPushButton:pressed { background: #dfeefa; }
QPushButton:disabled { color: #a7b1be; background: #f1f3f6; border-color: #e1e5eb; }
QPushButton#primaryButton { background: #1975bd; border-color: #1768a7; color: white; font-weight: 600; }
QPushButton#primaryButton:hover { background: #2388d5; }
QPushButton#primaryButton:disabled { background: #b3c7d9; border-color: #b3c7d9; color: #edf2f7; }
QPushButton#dangerButton { border-color: #dcb7b2; color: #a45048; }
QPushButton#viewButton { padding: 5px 10px; background: transparent; }
QComboBox, QLineEdit, QDoubleSpinBox, QSpinBox { background: #ffffff; border: 1px solid #ccd7e3; border-radius: 4px; padding: 7px 8px; min-height: 19px; selection-background-color: #227ac2; }
QComboBox:hover, QLineEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus { border-color: #6aa4d5; }
QComboBox::drop-down { border: 0; width: 23px; }
QComboBox QAbstractItemView { background: white; border: 1px solid #cad8e6; selection-background-color: #e5f0fc; selection-color: #215a8a; padding: 4px; }
QGroupBox { border: 1px solid #dce3eb; border-radius: 6px; margin-top: 12px; padding: 15px 10px 10px; background: #fbfcfe; }
QGroupBox::title { subcontrol-origin: margin; left: 11px; padding: 0 6px; color: #54708a; font-size: 11px; font-weight: 600; }
QTreeWidget { background: transparent; border: 0; outline: 0; font-size: 12px; }
QTreeWidget::item { padding: 7px 4px; border-radius: 3px; }
QTreeWidget::item:selected { background: #deecfa; color: #20659f; }
QTreeWidget::item:hover { background: #edf3fa; }
QTableWidget { background: white; border: 1px solid #d9e2ec; gridline-color: #e4eaf1; border-radius: 3px; }
QHeaderView::section { background: #edf2f8; color: #68809a; border: 0; border-bottom: 1px solid #d5dfeb; padding: 6px; font-size: 10px; }
QPlainTextEdit { background: #fafcfe; border: 1px solid #d6e0eb; border-radius: 4px; padding: 7px; font-family: monospace; font-size: 11px; }
QPlainTextEdit#calculationLog { background: #1c2c3e; color: #d0deeb; border: 0; border-radius: 0; padding: 12px; }
QCheckBox { spacing: 7px; padding: 4px 0; }
QCheckBox::indicator { width: 15px; height: 15px; border: 1px solid #b3c3d4; border-radius: 3px; background: white; }
QCheckBox::indicator:checked { background: #247fca; border-color: #247fca; }
QScrollArea { border: 0; background: #ffffff; }
QScrollBar:vertical { background: #f5f7fa; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: #cad5e1; min-height: 35px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QSplitter::handle { background: #d8e1eb; width: 1px; }
QStatusBar { background: #eaf0f7; border-top: 1px solid #d2dde8; color: #5d7790; min-height: 29px; }
QStatusBar::item { border: 0; }
QProgressBar { background: #d1deeb; border: 0; border-radius: 4px; }
QProgressBar::chunk { background: #2b86ce; border-radius: 4px; }
