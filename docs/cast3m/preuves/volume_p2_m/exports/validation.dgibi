OPTI 'DIME' 3 'ECHO' 0;
* Atelier Mailleur : importer depuis le dossier contenant le fichier UNV.
TAB1 = LIRE 'UNV' 'import_cast3m.unv' ;
MAIL1 = TAB1 . 'MAILLAGE' ;
* Completer ensuite modele, materiau, chargement et conditions limites.

LIST TAB1;
MESS 'MAILLEUR_NODES=' (NBNO (TAB1.'NOEUDS'));
MESS 'MAILLEUR_ELEMENTS=' (NBEL MAIL1);
MESS 'MAILLEUR_TYPE_SEG3=' (NBEL (TAB1.'@SEG3'));
MESS 'MAILLEUR_TYPE_TRI6=' (NBEL (TAB1.'@TRI6'));
MESS 'MAILLEUR_TYPE_TE10=' (NBEL (TAB1.'@TE10'));
MESS 'MAILLEUR_G_000=' (NBEL (TAB1.'BOUNDARY'));
MESS 'MAILLEUR_GN_000=' (NBNO (TAB1.'BOUNDARY_GN'));
MESS 'MAILLEUR_G_001=' (NBEL (TAB1.'DOMAIN'));
MESS 'MAILLEUR_GN_001=' (NBNO (TAB1.'DOMAIN_GN'));
MESS 'MAILLEUR_G_002=' (NBEL (TAB1.'FACE_001'));
MESS 'MAILLEUR_GN_002=' (NBNO (TAB1.'FACE_001_GN'));
MESS 'MAILLEUR_G_003=' (NBEL (TAB1.'FACE_002'));
MESS 'MAILLEUR_GN_003=' (NBNO (TAB1.'FACE_002_GN'));
MESS 'MAILLEUR_G_004=' (NBEL (TAB1.'FACE_003'));
MESS 'MAILLEUR_GN_004=' (NBNO (TAB1.'FACE_003_GN'));
MESS 'MAILLEUR_G_005=' (NBEL (TAB1.'FACE_004'));
MESS 'MAILLEUR_GN_005=' (NBNO (TAB1.'FACE_004_GN'));
MESS 'MAILLEUR_G_006=' (NBEL (TAB1.'FACE_005'));
MESS 'MAILLEUR_GN_006=' (NBNO (TAB1.'FACE_005_GN'));
MESS 'MAILLEUR_G_007=' (NBEL (TAB1.'FACE_006'));
MESS 'MAILLEUR_GN_007=' (NBNO (TAB1.'FACE_006_GN'));
MESS 'MAILLEUR_G_008=' (NBEL (TAB1.'GEOMETRY_1D'));
MESS 'MAILLEUR_GN_008=' (NBNO (TAB1.'GEOMETRY_1D_GN'));
MESS 'MAILLEUR_G_009=' (NBEL (TAB1.'GEOMETRY_2D'));
MESS 'MAILLEUR_GN_009=' (NBNO (TAB1.'GEOMETRY_2D_GN'));
MESS 'MAILLEUR_G_010=' (NBEL (TAB1.'PART_001'));
MESS 'MAILLEUR_GN_010=' (NBNO (TAB1.'PART_001_GN'));
MESS 'MAILLEUR_MIN_1=' (MINI (COOR 1 MAIL1));
MESS 'MAILLEUR_MAX_1=' (MAXI (COOR 1 MAIL1));
MESS 'MAILLEUR_MIN_2=' (MINI (COOR 2 MAIL1));
MESS 'MAILLEUR_MAX_2=' (MAXI (COOR 2 MAIL1));
MESS 'MAILLEUR_MIN_3=' (MINI (COOR 3 MAIL1));
MESS 'MAILLEUR_MAX_3=' (MAXI (COOR 3 MAIL1));
DOM = TAB1.'DOMAIN';
NODS = CHAN DOM 'POI1';
XC = COOR 1 NODS;
YC = COOR 2 NODS;
GAU = XC POIN 'MINI';
DRO = XC POIN 'MAXI';
BAS = YC POIN 'MINI';
FAD = TAB1.'BOUNDARY' ELEM 'APPU' 'STRICTEMENT' DRO;
MO = MODE DOM 'MECANIQUE' 'ELASTIQUE';
MA = MATE MO 'YOUN' 210000000000. 'NU' 0.29999999999999999;
RI = RIGI MO MA;
BL1 = BLOQ 'UX' GAU;
BL2 = BLOQ 'UY' BAS;
ZC = COOR 3 NODS;
ARRI = ZC POIN 'MINI';
BL3 = BLOQ 'UZ' ARRI;
BL2 = BL2 ET BL3;
FO = FSUR 'MASS' MO (10000000. 0. 0.) FAD;
UU = RESO (RI ET BL1 ET BL2) FO;
UX1 = EXCO 'UX' UU 'UX';
UY1 = EXCO 'UY' UU 'UY';
UTH = (10000000. / 210000000000.) * (NOMC 'UX' XC);
YTH = (-3000000. / 210000000000.) * (NOMC 'UY' YC);
ERRU = MAXI (UX1 - UTH) 'ABS';
SG = SIGM MO MA UU;
REA = REAC BL1 UU;
MESS 'MAILLEUR_UERROR=' ERRU;
MESS 'MAILLEUR_YERROR=' (MAXI (UY1 - YTH) 'ABS');
MESS 'MAILLEUR_UMAX=' (MAXI UX1);
MESS 'MAILLEUR_YMIN=' (MINI UY1);
MESS 'MAILLEUR_SMIN=' (MINI SG (MOTS 'SMXX'));
MESS 'MAILLEUR_SMAX=' (MAXI SG (MOTS 'SMXX'));
MESS 'MAILLEUR_FORCE_X=' (SOMM (EXTR FO 'VALE' 'FX'));
MESS 'MAILLEUR_REACTION_X=' (SOMM (EXTR REA 'VALE' 'FX'));
UZ1 = EXCO 'UZ' UU 'UZ';
ZTH = (-3000000. / 210000000000.) * (NOMC 'UZ' ZC);
MESS 'MAILLEUR_ZERROR=' (MAXI (UZ1 - ZTH) 'ABS');
MESS 'MAILLEUR_ZMIN=' (MINI UZ1);
MESS 'MAILLEUR_VALIDATION_OK';
FIN;
